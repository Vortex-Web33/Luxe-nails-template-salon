# Copia este archivo a .env si necesitas variables de entorno
# cp .env.example .env
# Por defecto el template NO requiere env vars — deja este archivo como referencia.

# Ejemplo: URL del sitio (solo si quieres sobreescribir SITE.url en CI)
# SITE_URL=https://midominio.com

# Ejemplo: Analytics privado (Plausible, Umami...)
# PUBLIC_ANALYTICS_ID=

# Ejemplo: endpoint de formulario (Formspree, Getform, n8n...)
# PUBLIC_FORM_ENDPOINT=https://formspree.io/f/xxxxxx
