---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/sections/Header.astro';
import Footer from '@/components/sections/Footer.astro';
import { SITE } from '@/config/site';
import { Icon } from 'astro-icon/components';

const canonical = `${SITE.url}/servicios/`;

const services = [
  {
    slug: 'manicura-madrid',
    title: 'Manicura en Madrid',
    short: 'Manicura Clásica',
    excerpt: 'Manicura clásica y semipermanente en Madrid centro. Limado perfecto, cutículas cuidadas y esmaltado de larga duración con base fortalecedora y top coat brillante. Resultado natural y elegante que dura semanas.',
    price: 'desde 25€',
    duration: '45 min',
    image: 'https://images.unsplash.com/photo-1604654894610-df63bc536371?q=80&w=800&auto=format&fit=crop',
    alt: 'Manicura en Madrid — manos con esmalte nude elegante Luxe Nail Studio Serrano 42',
  },
  {
    slug: 'unas-gel-madrid',
    title: 'Uñas de Gel en Madrid',
    short: 'Extensiones de Gel',
    excerpt: 'Extensiones de uñas de gel en Madrid esculpidas a medida, ultraligeras y resistentes. Forma almendra, cuadrada o stiletto con acabado natural y brillo espejo que no se descascarilla.',
    price: 'desde 45€',
    duration: '90–120 min',
    image: 'https://images.unsplash.com/photo-1522337660859-02fbefca4702?q=80&w=800&auto=format&fit=crop',
    alt: 'Uñas de gel en Madrid — extensiones esculpidas con acabado natural Luxe Salamanca',
  },
  {
    slug: 'nail-art-madrid',
    title: 'Nail Art en Madrid',
    short: 'Nail Art Exclusivo',
    excerpt: 'Nail art exclusivo en Madrid — minimalista, francés moderno, cromados, piedras o diseños joya. Creaciones 100% personalizadas por nuestras nail artists expertas en Serrano 42.',
    price: 'desde 30€',
    duration: '60–120 min',
    image: 'https://images.unsplash.com/photo-1596462502278-27bfdc403348?q=80&w=800&auto=format&fit=crop',
    alt: 'Nail art en Madrid — diseño exclusivo minimalista en tonos rosa Luxe Studio',
  },
  {
    slug: 'pedicura-madrid',
    title: 'Pedicura en Madrid',
    short: 'Pedicura Spa Premium',
    excerpt: 'Pedicura spa de lujo en Madrid con exfoliación, hidratación profunda, masaje relajante y esmaltado premium. Pies suaves, bonitos y renovados con higiene medical-grade y esmaltes veganos.',
    price: 'desde 35€',
    duration: '60 min',
    image: 'https://images.unsplash.com/photo-1515688594390-b649af70d282?q=80&w=800&auto=format&fit=crop',
    alt: 'Pedicura en Madrid — pedicura spa de lujo con masaje y esmaltado premium Salamanca',
  },
];

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Servicios', item: canonical },
  ],
};

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Servicios de manicura en Madrid — Luxe Nail Studio',
  description: 'Catálogo completo de manicura, uñas de gel, nail art y pedicura en Madrid. Luxe Nail Studio en Serrano 42, Salamanca.',
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${SITE.url}/servicios/${s.slug}/`,
    name: s.title,
  })),
};

const jsonLd = [breadcrumbJsonLd, itemListJsonLd];
---

<Layout
  title="Servicios de Manicura en Madrid | Luxe Nail Studio Serrano 42"
  description="Servicios completos de manicura en Madrid — manicura clásica desde 25€ (45 min), uñas de gel desde 45€, nail art desde 30€ y pedicura spa desde 35€. En Serrano 42, Salamanca, a minutos de Chamartín. Reserva en 30 segundos."
  canonical={canonical}
  jsonLd={jsonLd}
>
  <Header />

  <main id="main" class="bg-[#fdf6f3]">
    <!-- Hero pillar -->
    <section class="relative overflow-hidden bg-black pb-16 pt-28 sm:pb-20 sm:pt-32 lg:pt-36">
      <div class="absolute inset-0">
        <img src="https://images.unsplash.com/photo-1632345031435-8727f6897d53?q=80&w=2000&auto=format&fit=crop" alt="Servicios de manicura en Madrid — Luxe Nail Studio Serrano 42, Salamanca" class="h-full w-full object-cover opacity-35" loading="eager" decoding="async" />
        <div class="absolute inset-0 bg-gradient-to-t from-black via-black/60 to-black/20"></div>
      </div>
      <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <nav aria-label="Miga de pan" class="text-xs tracking-wide text-white/60">
          <ol class="flex items-center gap-2">
            <li><a href="/" class="hover:text-white hover:underline underline-offset-4">Inicio</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" class="text-white font-medium">Servicios</li>
          </ol>
        </nav>
        <p class="mt-6 text-xs font-semibold uppercase tracking-[0.22em] text-brand-300">Serrano 42, Salamanca — a 5 min de Chamartín • Madrid centro</p>
        <h1 class="mt-3 max-w-3xl font-serif text-4xl font-semibold leading-[0.95] tracking-tight text-white sm:text-5xl lg:text-[3.5rem]">
          Servicios de <span class="text-brand-300">Manicura en Madrid</span>
        </h1>
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-white/75 sm:text-lg">
          Cuatro rituales boutique con productos premium veganos, esterilización medical-grade y acabados impecables. Desde la manicura clásica de 45 min hasta las extensiones de gel de 2 horas, todo a pasos de Chamartín y del centro de Madrid. Descubre tu servicio ideal y reserva en 30 segundos.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/#contacto" class="inline-flex items-center gap-2 rounded-full bg-[#d48a8a] px-7 py-3.5 text-xs font-bold uppercase tracking-[0.14em] text-white shadow-[0_8px_24px_rgba(212,138,138,0.32)] transition hover:bg-[#c27474]">Reservar manicura en Madrid <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" /></a>
          <a href="/#nosotros" class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-7 py-3.5 text-xs font-semibold uppercase tracking-[0.14em] text-white backdrop-blur transition hover:bg-white/10">Conócenos</a>
        </div>
        <dl class="mt-10 grid max-w-xl grid-cols-3 gap-6 border-t border-white/10 pt-8">
          <div><dd class="font-serif text-2xl font-semibold text-white">10k+</dd><dt class="mt-1 text-[10px] font-medium uppercase tracking-[0.16em] text-white/60">Servicios</dt></div>
          <div><dd class="font-serif text-2xl font-semibold text-white">4.9/5</dd><dt class="mt-1 text-[10px] font-medium uppercase tracking-[0.16em] text-white/60">Valoración Madrid</dt></div>
          <div><dd class="font-serif text-2xl font-semibold text-white">45–120 min</dd><dt class="mt-1 text-[10px] font-medium uppercase tracking-[0.16em] text-white/60">Duración</dt></div>
        </dl>
      </div>
    </section>

    <!-- Grid servicios -->
    <section aria-labelledby="lista-servicios" class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-brand-500">Catálogo completo</p>
          <h2 id="lista-servicios" class="mt-3 font-serif text-3xl font-bold tracking-tight text-[#3d2222] sm:text-4xl">Elige tu ritual Luxe en Madrid</h2>
          <p class="mt-4 text-[15px] leading-relaxed text-zinc-500">Todos los servicios incluyen diagnóstico gratuito, asesoría de estilo y acabado con cutículas perfectas. Precios transparentes y duración confirmada al reservar.</p>
        </div>

        <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:gap-8">
          {services.map((s) => (
            <article class="group flex flex-col overflow-hidden rounded-[20px] border border-black/5 bg-white shadow-[0_8px_30px_rgba(61,34,34,0.06)] transition hover:shadow-[0_16px_40px_rgba(61,34,34,0.12)]">
              <div class="relative aspect-[16/10] overflow-hidden bg-zinc-100">
                <img src={s.image} alt={s.alt} class="h-full w-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" decoding="async" />
                <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-60"></div>
                <div class="absolute left-4 top-4 inline-flex items-center gap-2 rounded-full bg-white/90 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-[#3d2222] shadow backdrop-blur">
                  <span class="size-1.5 rounded-full bg-[#d48a8a]"></span> {s.short}
                </div>
                <div class="absolute bottom-4 right-4 flex gap-2">
                  <span class="rounded-full bg-black/75 px-3 py-1 text-xs font-semibold text-white backdrop-blur">{s.price}</span>
                  <span class="rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-[#3d2222] backdrop-blur">{s.duration}</span>
                </div>
              </div>
              <div class="flex flex-1 flex-col p-6 sm:p-7">
                <h3 class="font-serif text-lg font-semibold tracking-tight text-[#1a1a1a]"><a href={`/servicios/${s.slug}`} class="hover:text-brand-600 hover:underline underline-offset-4">{s.title}</a></h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-zinc-500">{s.excerpt}</p>
                <div class="mt-6 flex items-center gap-3">
                  <a href={`/servicios/${s.slug}`} aria-label={`Ver ${s.title} — detalles, precio y duración en Serrano 42`} class="inline-flex items-center gap-1.5 rounded-full bg-[#0a0a0a] px-5 py-2.5 text-xs font-semibold uppercase tracking-[0.14em] text-white transition hover:bg-[#3d2222]">Ver servicio <Icon name="lucide:arrow-right" class="size-3.5" aria-hidden="true" /></a>
                  <a href="/#contacto" class="text-xs font-semibold uppercase tracking-[0.14em] text-zinc-500 underline-offset-4 hover:text-brand-600 hover:underline">Reservar</a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="mt-14 rounded-2xl border border-brand-200/40 bg-white p-6 sm:p-8 lg:p-10">
          <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
            <div class="max-w-2xl">
              <h3 class="font-serif text-xl font-semibold text-[#1a1a1a]">Manicura en Salamanca, a minutos de Chamartín y centro de Madrid</h3>
              <p class="mt-2 text-sm leading-relaxed text-zinc-500">
                Estamos en <strong class="font-semibold text-zinc-700">Calle Serrano 42, 28001 Madrid</strong> — barrio de Salamanca, junto a metros Serrano y Rubén Darío, a 5 min de Chamartín, Chamberí y Retiro. Llega fácil desde AZCA, Nuevos Ministerios o la Castellana. Abierto Lun–Sáb 10:00–20:00, última cita una hora antes del cierre.
                Enlaza directo a <a href="/servicios/manicura-madrid" class="font-semibold text-brand-600 underline-offset-4 hover:underline">manicura clásica en Madrid</a>, <a href="/servicios/unas-gel-madrid" class="font-semibold text-brand-600 underline-offset-4 hover:underline">uñas de gel en Madrid</a>, <a href="/servicios/nail-art-madrid" class="font-semibold text-brand-600 underline-offset-4 hover:underline">nail art en Madrid</a> o <a href="/servicios/pedicura-madrid" class="font-semibold text-brand-600 underline-offset-4 hover:underline">pedicura en Madrid</a> según lo que busques hoy.
              </p>
            </div>
            <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
              <a href="/#contacto" class="inline-flex items-center justify-center gap-2 rounded-full bg-[#d48a8a] px-6 py-3 text-xs font-bold uppercase tracking-[0.14em] text-white shadow transition hover:bg-[#c27474]">Reservar manicura en Madrid</a>
              <a href="/#galeria" class="inline-flex items-center justify-center gap-2 rounded-full border border-black/10 bg-white px-6 py-3 text-xs font-semibold uppercase tracking-[0.14em] text-[#3d2222] transition hover:border-brand-300/40 hover:text-brand-600">Ver galería</a>
            </div>
          </div>
          <p class="mt-6 border-t border-black/5 pt-6 text-xs leading-relaxed text-zinc-400">
            ¿Dudas entre servicios? Nuestra asesora te ayuda a elegir: si buscas natural y rápido, <a href="/servicios/manicura-madrid" class="font-medium text-brand-600 hover:underline">manicura clásica</a> (45 min); si quieres longitud y resistencia, <a href="/servicios/unas-gel-madrid" class="font-medium text-brand-600 hover:underline">uñas de gel</a> (90–120 min); si te apasiona el diseño, <a href="/servicios/nail-art-madrid" class="font-medium text-brand-600 hover:underline">nail art</a> (60–120 min); si buscas bienestar total, <a href="/servicios/pedicura-madrid" class="font-medium text-brand-600 hover:underline">pedicura spa</a> (60 min).
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

