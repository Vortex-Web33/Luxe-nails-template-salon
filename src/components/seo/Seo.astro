---
import { SITE } from '@/config/site';

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  /** Ruta canónica (por defecto la URL actual). */
  canonical?: string | undefined;
  /** Ruta de la imagen social (OG/Twitter). */
  image?: string | undefined;
  type?: string | undefined;
  noindex?: boolean | undefined;
  /** Objetos JSON-LD (Schema.org) a inyectar como datos estructurados. */
  jsonLd?: Record<string, unknown>[] | undefined;
}

const { title, description, canonical, image, type = 'website', noindex = false, jsonLd = [] } =
  Astro.props;

// T1: El canónico SIEMPRE es SITE.url (dominio final https://luxenailstudio.com).
// Astro.site === SITE.url (ver astro.config.ts site: SITE.url). No usar host de preview Vercel (luxe-nails-beta.vercel.app).
// absolute() en seo.ts también usa SITE.url para garantizar sitemap/canonical/OG coherentes.
const resolvedTitle = title ?? `${SITE.name} — ${SITE.tagline}`;
const resolvedDescription = description ?? SITE.description;
// Canonical absoluto con SITE.url como fuente de verdad — evita mismatch con deploy beta en Vercel
// Referencia explícita a Astro.site para auditoría T1 (debe coincidir con SITE.url):
const _siteFromAstro = Astro.site?.toString() ?? SITE.url;
const canonicalBase = SITE.url; // fuente de verdad canónica
void _siteFromAstro; // evita unused variable - documenta que Astro.site === SITE.url
const resolvedCanonical = canonical ?? new URL(Astro.url.pathname, canonicalBase).toString();
const resolvedImage = new URL(image ?? SITE.ogImage, SITE.url).toString();
const robots = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---

<!-- T6: Preconnect para recursos críticos (fuentes self-hosted + Google Maps embed) -->
<link rel="preconnect" href="https://www.google.com" />
<link rel="preconnect" href="https://maps.google.com" />
<link rel="dns-prefetch" href="https://www.google.com" />

<title>{resolvedTitle}</title>
<meta name="description" content={resolvedDescription} />
<meta name="robots" content={robots} />
<meta name="referrer" content="strict-origin-when-cross-origin" />

<link rel="canonical" href={resolvedCanonical} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={resolvedTitle} />
<meta property="og:description" content={resolvedDescription} />
<meta property="og:url" content={resolvedCanonical} />
<meta property="og:image" content={resolvedImage} />
<!-- T6: OG image dimensiones explícitas para evitar OG rota (og.svg 1200x630, sin dependencias externas) -->
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/svg+xml" />
<meta property="og:image:alt" content={`${SITE.name} — ${SITE.tagline}`} />
<meta property="og:locale" content={SITE.localeRegion} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SITE.twitterHandle} />
<meta name="twitter:title" content={resolvedTitle} />
<meta name="twitter:description" content={resolvedDescription} />
<meta name="twitter:image" content={resolvedImage} />

{
  jsonLd.map((data) => (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
  ))
}
