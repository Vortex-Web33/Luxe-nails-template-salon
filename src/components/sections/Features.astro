---
import { Icon } from 'astro-icon/components';
import { CONTENT } from '@/config/site';

const { features, services } = CONTENT;

// Imágenes Unsplash curadas para cada servicio (optimizadas, consistentes con estética luxe rosa)
const serviceImages = [
  'https://images.unsplash.com/photo-1604654894610-df63bc536371?q=80&w=600&auto=format&fit=crop', // Classic Manicure — manos elegantes
  'https://images.unsplash.com/photo-1522337660859-02fbefca4702?q=80&w=600&auto=format&fit=crop', // Gel Extensions — uñas con acabado gel
  'https://images.unsplash.com/photo-1596462502278-27bfdc403348?q=80&w=600&auto=format&fit=crop', // Nail Art — close-up arte
  'https://images.unsplash.com/photo-1515688594390-b649af70d282?q=80&w=600&auto=format&fit=crop', // Premium Pedicure — pedicura spa
];

const fallbackImages = [
  'https://images.unsplash.com/photo-1519014816548-bf5fe059798b?q=80&w=600&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1634449571010-02389ed0f357?q=80&w=800&auto=format&fit=crop',
];

// Decisión de datos: usa CONTENT.services (4 items) si existe; si está vacío, fallback a features.items
const hasServices = services.length > 0;
const cards = hasServices
  ? services.map((s, i) => ({
      title: s.name,
      description: s.description,
      image: serviceImages[i] ?? fallbackImages[i % fallbackImages.length],
    }))
  : features.items.length > 0
    ? [
        ...features.items.map((f, i) => ({
          title: f.title,
          description: f.description,
          image: serviceImages[i] ?? fallbackImages[i % fallbackImages.length],
        })),
        // Si solo hay 3 features, añade un cuarto visual para completar el grid 4
        ...(features.items.length === 3
          ? [
              {
                title: 'Premium Pedicure',
                description:
                  'Pedicura spa de lujo con exfoliación, masaje y esmaltado premium para unos pies totalmente renovados.',
                image: serviceImages[3],
              },
            ]
          : []),
      ]
    : [];

// Encabezado: eyebrow/subtitle vienen de CONTENT.features; título visual fijo "OUR SIGNATURE SERVICES"
const eyebrow = features.eyebrow;
const subtitle = features.subtitle;
---

<section
  id="servicios"
  aria-labelledby="servicios-title"
  class="bg-[#fdf6f3] py-16 sm:py-20"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    {/* Encabezado — fiel a referencia: left on desktop, center on mobile */}
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-xl">
        <p
          class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-500"
        >
          NUESTROS
        </p>
        <h2
          id="servicios-title"
          class="mt-1 font-serif text-3xl font-semibold leading-none tracking-[0.04em] text-[#1a1a1a] sm:text-4xl lg:text-[2.6rem]"
        >
          <span class="block text-brand-500">SERVICIOS</span>
          <span class="block">EXCLUSIVOS</span>
        </h2>
        <p class="mt-4 max-w-xl text-sm leading-relaxed text-zinc-500 sm:text-[15px]">
          {subtitle}
        </p>
      </div>
      <div class="hidden items-center gap-3 lg:flex">
        <span class="text-[11px] font-semibold uppercase tracking-[0.2em] text-zinc-900">Explorar servicios</span>
        <span class="h-px w-12 bg-zinc-900" aria-hidden="true"></span>
      </div>
      {/* mobile divider */}
      <div class="mx-auto h-px w-12 bg-brand-300 lg:hidden" aria-hidden="true"></div>
    </div>
    {/* subtitle eyebrow mobile center fallback */}
    <p class="mt-3 hidden text-center text-xs uppercase tracking-[0.2em] text-brand-500 lg:hidden">{eyebrow}</p>

    {
      cards.length > 0 ? (
        <div class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {cards.map((card) => (
            <article class="group relative flex min-h-[380px] flex-col overflow-hidden rounded-[18px] bg-[#111] sm:min-h-[420px]">
              {/* Imagen */}
              <div class="absolute inset-0 overflow-hidden">
                <img
                  src={card.image}
                  alt={card.title}
                  class="h-full w-full object-cover transition duration-700 ease-out group-hover:scale-105"
                  loading="lazy"
                  decoding="async"
                />
              </div>

              {/* Overlay degradado */}
              <div
                class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent opacity-90"
                aria-hidden="true"
              />
              <div
                class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 transition duration-500 group-hover:opacity-100"
                aria-hidden="true"
              />

              {/* Borde sutil luxe */}
              <div
                class="pointer-events-none absolute inset-0 rounded-[18px] ring-1 ring-white/10 group-hover:ring-white/15"
                aria-hidden="true"
              />

              {/* Contenido abajo */}
              <div class="relative mt-auto p-6">
                <h3 class="font-serif text-[13px] font-semibold uppercase tracking-[0.16em] text-white">
                  {card.title}
                </h3>
                <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-white/70">
                  {card.description}
                </p>
                <span class="mt-4 inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-[0.18em] text-brand-200 opacity-0 transition duration-300 group-hover:opacity-100">
                  Descubrir
                  <Icon name="lucide:arrow-right" class="size-3" aria-hidden="true" />
                </span>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p class="mx-auto mt-12 max-w-lg rounded-2xl border border-dashed border-white/10 bg-white/[0.03] px-6 py-10 text-center text-sm text-white/40">
          Sin servicios configurados — añade elementos en{' '}
          <code class="rounded bg-white/10 px-1.5 py-0.5 font-mono text-xs text-white/60">
            CONTENT.services
          </code>{' '}
          o{' '}
          <code class="rounded bg-white/10 px-1.5 py-0.5 font-mono text-xs text-white/60">
            CONTENT.features.items
          </code>
        </p>
      )
    }
  </div>
</section>
