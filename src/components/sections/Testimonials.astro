---
import { CONTENT } from '@/config/site';
import TestimonialCarousel from '@/components/react/TestimonialCarousel.tsx';

const { testimonials } = CONTENT;

// Si no hay testimonios, no renderizamos la sección (evita sección vacía en producción).
const hasItems = testimonials.items.length > 0;

// Traducción robusta del eyebrow
const eyebrowLabel = testimonials.eyebrow === 'Testimonials' ? 'Reseñas' : testimonials.eyebrow || 'Reseñas';

// Mocks extra para el carrusel rotativo: 5 reseñas adicionales (total 8 con las 3 de CONTENT)
// Todas con 5/5 estrellas
const extraMocks = [
  {
    quote: 'El nail art es una locura, siempre me sorprenden con diseños nuevos. ¡Mi sitio favorito sin duda!',
    name: 'Martina G.',
    role: 'Influencer',
  },
  {
    quote: 'Ambiente súper elegante y relajante. Sales como nueva y las uñas duran semanas perfectas.',
    name: 'Lucía P.',
    role: 'Arquitecta',
  },
  {
    quote: 'Productos de primera calidad y trato cercano. Se nota el cuidado en cada detalle.',
    name: 'Daniela F.',
    role: 'Profesora de yoga',
  },
  {
    quote: 'Higiene impecable, me siento segura en cada visita. Además el resultado es de revista.',
    name: 'Paula N.',
    role: 'Médica',
  },
  {
    quote: 'Me asesoraron con el color ideal para mi tono de piel. ¡Acertaron de pleno, estoy encantada!',
    name: 'Irene S.',
    role: 'Estilista',
  },
];

const allReviews = [...testimonials.items, ...extraMocks];
---

{
  hasItems && (
    <section id="testimonios" aria-labelledby="testimonios-title" class="bg-[#0a0a0a] py-20 sm:py-28 lg:py-36">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-300 sm:text-sm">{eyebrowLabel} — Salamanca, Madrid</p>
        <h2 id="testimonios-title" class="mt-3 font-serif text-4xl font-semibold tracking-tight text-white sm:text-5xl lg:text-[3.4rem]">
          {testimonials.title}
        </h2>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-white/60 sm:text-lg">
          Más de 10.000 clientas satisfechas en Salamanca, Chamartín y todo Madrid centro nos avalan. Experiencias reales de manicura, gel y nail art con valoración 5/5 en nuestro salón de Serrano 42.
        </p>

        <div class="mt-14 lg:mt-16">
          <TestimonialCarousel items={allReviews} client:visible />
        </div>
      </div>
    </section>
  )
}
