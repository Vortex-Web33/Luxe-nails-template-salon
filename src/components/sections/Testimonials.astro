---
import { Icon } from 'astro-icon/components';
import { CONTENT } from '@/config/site';

const { testimonials } = CONTENT;

// Si no hay testimonios, no renderizamos la sección (evita sección vacía en producción).
const hasItems = testimonials.items.length > 0;
---

{
  hasItems && (
    <section id="testimonios" aria-labelledby="testimonios-title" class="bg-[#0a0a0a] py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-300">{testimonials.eyebrow}</p>
        <h2 id="testimonios-title" class="mt-3 font-serif text-3xl font-normal tracking-tight text-white sm:text-4xl">
          {testimonials.title}
        </h2>

        <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-3">
          {testimonials.items.map((testimonial) => (
            <figure class="flex flex-col justify-between rounded-2xl border border-white/10 bg-white/[0.04] p-7 backdrop-blur-sm">
              <div class="flex items-center gap-0.5 text-brand-300" aria-label="Valoración: 5 de 5 estrellas">
                {Array.from({ length: 5 }, () => (
                  <Icon name="lucide:star" class="size-4 fill-current" aria-hidden="true" />
                ))}
              </div>
              <blockquote class="mt-4 text-sm leading-relaxed text-white/75">“{testimonial.quote}”</blockquote>
              <figcaption class="mt-6 border-t border-white/10 pt-4">
                <p class="font-semibold text-white">{testimonial.name}</p>
                <p class="text-sm text-white/50">{testimonial.role}</p>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )
}
