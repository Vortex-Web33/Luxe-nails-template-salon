---
import { CONTENT } from '@/config/site';

const { cta } = CONTENT;
---

<section
  aria-labelledby="cta-title"
  class="overflow-hidden bg-[#0a0a0a]"
>
  <div class="mx-auto grid max-w-[1400px] grid-cols-1 lg:grid-cols-[1.1fr_0.9fr]">
    {/* Columna texto */}
    <div
      class="flex flex-col justify-center px-6 py-14 sm:px-10 sm:py-16 lg:px-16 xl:px-20 lg:py-20"
    >
      <p
        class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-300"
      >
        ¿Lista para brillar en Madrid?
      </p>

      <h2
        id="cta-title"
        class="mt-4 max-w-xl font-serif text-3xl font-semibold uppercase leading-[0.95] tracking-[0.04em] text-white sm:text-4xl lg:text-[2.7rem]"
      >
        {/* H2 geo-optimizado: incluye Manicura en Madrid */}
        <span class="block text-white">RESERVA TU</span>
        <span class="block text-brand-200">MANICURA</span>
        <span class="block text-white text-2xl sm:text-3xl lg:text-[2rem]">EN MADRID HOY</span>
        <span class="sr-only">{cta.title}</span>
      </h2>

      <p
        class="mt-5 max-w-md text-sm leading-relaxed text-white/60 sm:text-[15px]"
      >
        {cta.subtitle}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href={cta.action.href}
          aria-label="Reservar manicura en Madrid — Luxe Nail Studio Serrano 42, Salamanca"
          class="inline-flex items-center justify-center rounded-full bg-brand-500 px-8 py-3.5 text-sm font-bold uppercase tracking-[0.12em] text-white shadow-[0_8px_30px_rgba(212,138,138,0.35)] transition hover:bg-brand-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-300 focus-visible:ring-offset-2 focus-visible:ring-offset-[#0a0a0a]"
        >
          {cta.action.label}
        </a>
      </div>
      <p class="mt-4 text-xs uppercase tracking-[0.16em] text-white/30">Serrano 42, Salamanca — a un paso de Chamartín · Madrid · Desde 25€ · 45–120 min</p>
    </div>

    {/* Columna imagen — frasco esmalte rosa */}
    <div
      class="relative min-h-[360px] overflow-hidden bg-[#141414] lg:min-h-[520px]"
    >
      <img
        src="https://images.unsplash.com/photo-1632345031435-8727f6897d53?q=80&w=800&auto=format&fit=crop"
        alt="Frasco de esmalte rosa — Luxe Nail Studio"
        class="absolute inset-0 h-full w-full object-cover object-center"
        loading="lazy"
        decoding="async"
      />
      {/* Overlay para fusión con el fondo negro y asegurar contraste en móvil */}
      <div
        class="pointer-events-none absolute inset-0 bg-gradient-to-l from-transparent via-transparent to-[#0a0a0a]/60 lg:to-[#0a0a0a]/10"
        aria-hidden="true"
      />
      <div
        class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#0a0a0a]/30 via-transparent to-transparent lg:hidden"
        aria-hidden="true"
      />
      {/* Viñeta sutil interior */}
      <div
        class="pointer-events-none absolute inset-0 ring-1 ring-inset ring-white/5"
        aria-hidden="true"
      />
    </div>
  </div>
</section>
