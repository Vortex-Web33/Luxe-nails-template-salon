---
import { Icon } from 'astro-icon/components';
import { SITE } from '@/config/site';
---

<section id="contacto" aria-labelledby="contacto-title" class="border-t border-black/[0.04] bg-[#fdf6f3] py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#d48a8a]">Contacto</p>
      <h2 id="contacto-title" class="mt-3 font-serif text-3xl font-bold tracking-tight text-[#3d2222] sm:text-4xl">
        Hablemos de tu proyecto
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-[#8d4f4f]/70">
        Escríbenos y te respondemos en menos de 24 horas laborables, con una propuesta inicial sin compromiso.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      <div class="group rounded-2xl border border-black/[0.06] bg-white p-7 shadow-[0_8px_30px_rgba(61,34,34,0.04)] transition hover:shadow-[0_12px_40px_rgba(61,34,34,0.08)]">
        <div class="mb-4 flex size-9 items-center justify-center rounded-full bg-[#fdf6f3] border border-black/[0.04] text-[#d48a8a]">
          <Icon name="lucide:mail" class="size-4" aria-hidden="true" />
        </div>
        <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-[#3d2222]">Email</p>
        <a href={`mailto:${SITE.contact.email}`} class="mt-2 block break-all text-sm font-medium text-[#c27474] transition group-hover:text-[#8d4f4f]">
          {SITE.contact.email}
        </a>
      </div>

      <div class="group rounded-2xl border border-black/[0.06] bg-white p-7 shadow-[0_8px_30px_rgba(61,34,34,0.04)] transition hover:shadow-[0_12px_40px_rgba(61,34,34,0.08)]">
        <div class="mb-4 flex size-9 items-center justify-center rounded-full bg-[#fdf6f3] border border-black/[0.04] text-[#d48a8a]">
          <Icon name="lucide:phone" class="size-4" aria-hidden="true" />
        </div>
        <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-[#3d2222]">Teléfono</p>
        <a href={`tel:${SITE.contact.phone.replace(/\s/g, '')}`} class="mt-2 block text-sm font-medium text-[#c27474] transition group-hover:text-[#8d4f4f]">
          {SITE.contact.phone}
        </a>
      </div>

      <div class="group rounded-2xl border border-black/[0.06] bg-white p-7 shadow-[0_8px_30px_rgba(61,34,34,0.04)] transition hover:shadow-[0_12px_40px_rgba(61,34,34,0.08)]">
        <div class="mb-4 flex size-9 items-center justify-center rounded-full bg-[#fdf6f3] border border-black/[0.04] text-[#d48a8a]">
          <Icon name="lucide:map-pin" class="size-4" aria-hidden="true" />
        </div>
        <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-[#3d2222]">Dirección</p>
        <address class="mt-2 text-sm not-italic leading-relaxed text-[#744141]/80">
          {SITE.contact.address}
        </address>
      </div>

      <div class="group rounded-2xl border border-black/[0.06] bg-white p-7 shadow-[0_8px_30px_rgba(61,34,34,0.04)] transition hover:shadow-[0_12px_40px_rgba(61,34,34,0.08)]">
        <div class="mb-4 flex size-9 items-center justify-center rounded-full bg-[#fdf6f3] border border-black/[0.04] text-[#d48a8a]">
          <Icon name="lucide:clock" class="size-4" aria-hidden="true" />
        </div>
        <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-[#3d2222]">Horario</p>
        <p class="mt-2 text-sm leading-relaxed text-[#744141]/80">{SITE.contact.hours}</p>
      </div>
    </div>
  </div>
</section>
