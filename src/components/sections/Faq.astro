---
import { CONTENT } from '@/config/site';
import FaqAccordion from '@/components/react/FaqAccordion.tsx';

const { faq } = CONTENT;
const hasItems = faq.items.length > 0;
---

{
  hasItems && (
    <section id="faq" aria-labelledby="faq-title" class="bg-[#fdf6f3] py-20 sm:py-28 lg:py-36">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-brand-500 sm:text-sm">{faq.eyebrow}</p>
        <h2 id="faq-title" class="mt-3 text-center font-serif text-4xl font-semibold tracking-tight text-[#1a1a1a] sm:text-5xl lg:text-[3.2rem]">
          {faq.title}
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-center text-base leading-relaxed text-zinc-500 sm:text-lg">
          Resolvemos tus dudas sobre manicura, uñas de gel y nail art en nuestro salón de Serrano 42, Salamanca — precios desde 25€, duración 45–120 min, productos premium y atención cercana en Madrid.
        </p>

        <div class="mt-14">
          <FaqAccordion items={faq.items} client:visible />
        </div>
      </div>
    </section>
  )
}
