---
import { CONTENT } from '@/config/site';
import FaqAccordion from '@/components/react/FaqAccordion.tsx';

const { faq } = CONTENT;
const hasItems = faq.items.length > 0;
---

{
  hasItems && (
    <section id="faq" aria-labelledby="faq-title" class="bg-[#fdf6f3] py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-brand-500">{faq.eyebrow}</p>
        <h2 id="faq-title" class="mt-3 text-center font-serif text-3xl font-normal tracking-tight text-[#1a1a1a] sm:text-4xl">
          {faq.title}
        </h2>

        <div class="mt-14">
          <FaqAccordion items={faq.items} client:visible />
        </div>
      </div>
    </section>
  )
}
